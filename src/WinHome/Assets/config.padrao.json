// Configuração do WinHome. Salve o arquivo e a Home atualiza sozinha.
// Comentários com // são permitidos. Opções ausentes usam o valor padrão.
// Salvar pela tela de Configurações regrava o arquivo sem comentários (anterior em config.json.bak).
// Todas as opções: docs/configuracao.md
{
  // Nome usado na saudação ("Bom dia, Marcos").
  "nome": "Marcos",

  // "maximizada" = ocupa a tela mas mantém a barra de tarefas; "telaCheia" = cobre tudo.
  "janela": "maximizada",

  // Tecla para mostrar/esconder a Home. Ex.: "Ctrl+Alt+Space", "Ctrl+Shift+H", "Alt+F1".
  "atalho": "Ctrl+Alt+Space",

  // true = abre a Home ao fazer login (cria o valor WinHome em HKCU\...\Run; false remove).
  "iniciarComWindows": false,

  // Esconde a Home depois de abrir um app.
  "esconderAoAbrirApp": true,

  // Caixa de busca no topo; digitar em qualquer lugar da Home também busca.
  "mostrarBusca": true,

  // Ícone na bandeja do sistema (clique mostra a Home; botão direito: Configurações, Sair).
  "iconeNaBandeja": true,

  "tema": {
    "modo": "escuro",              // "escuro", "claro" ou "sistema"
    "corDestaque": "#4F8CFF",      // títulos e relógio; "#RRGGBB" ou "#AARRGGBB"
    "fundo": "mica",               // "mica", "micaAlt", "acrilico", "cor" ou "imagem"
    "corFundo": "#101418",         // usada quando fundo = "cor"
    "imagemFundo": "",             // caminho da imagem quando fundo = "imagem"
    "fonte": "Segoe UI Variable",
    "cantos": 12,                  // arredondamento dos painéis
    "tamanhoIcone": 48,
    "opacidadePaineis": 0.6,       // 0 = transparente, 1 = sólido
    "espacamento": 16,             // distância entre painéis
    "colunas": 6                   // colunas da grade; cada painel ocupa "largura" colunas
  },

  // Painel do topo (id "boasVindas").
  "boasVindas": {
    "mostrarSaudacao": true,
    "mostrarData": true,
    "mostrarSegundos": false,
    // Clima (Open-Meteo). Adicione cidades pela busca em Configurações → Boas-vindas.
    "clima": {
      "visivel": true,
      "unidade": "C",
      "cidades": [
        { "nome": "São Paulo", "regiao": "São Paulo", "pais": "Brasil", "latitude": -23.5475, "longitude": -46.63611, "fuso": "America/Sao_Paulo" },
        { "nome": "Orlando", "regiao": "Flórida", "pais": "EUA", "latitude": 28.53834, "longitude": -81.37924, "fuso": "America/New_York" }
      ]
    },
    // Cotações em reais (AwesomeAPI): USD, EUR, GBP, JPY, CAD, AUD, CHF, CNY, ARS, BTC, ETH.
    "cotacoes": {
      "visivel": true,
      "moedas": [ "USD", "EUR" ]
    }
  },

  // Painel "mensagem": frase do dia. "fonte": "ambas", "embutidas" (do WinHome) ou "minhas".
  "mensagens": {
    "fonte": "ambas",
    "minhas": [
      // { "texto": "Minha frase", "autor": "Eu" }
    ]
  },

  // Painel "curiosidade": fatos da data de hoje com foto (Wikipédia "Neste dia").
  "curiosidades": {
    "incluirNascimentos": false,
    "incluirMortes": false
  },

  // Painel "projetos": recentes das IDEs + subpastas com git das "pastas".
  // Ligue em Configurações → Projetos (ou adicione { "id": "projetos" } em "paineis").
  "projetos": {
    "usarIntellij": true,
    "usarAndroidStudio": true,
    "usarVsCode": true,
    "pastas": [ "D:\\Documents\\dev" ],
    "maximo": 8,
    "editorPadrao": "origem",      // "origem" (IDE onde foi aberto), "vscode", "intellij" ou "androidStudio"
    "fixados": [],                 // caminhos que ficam sempre no topo
    "ocultos": [],                 // caminhos que não aparecem
    // Caminhos dos executáveis; vazio = detectar sozinho.
    "editores": { "vsCode": "", "intellij": "", "androidStudio": "" }
  },

  // Painel "tarefas": a lista fica em %APPDATA%\WinHome\tarefas.json (fora desta config).
  "tarefas": {
    "mostrarConcluidas": true      // concluídas aparecem riscadas no fim da lista
  },

  // Painel "acoes": cada ação executa os passos em ordem, SEMPRE depois de confirmar (mostrando o comando exato).
  // Passo: "app" (AppID), "editor" (vscode, intellij, androidStudio — detectado como em Projetos)
  // ou "caminho" + "args". Marcadores: "{pastaProjetos}" (repete o passo para cada pasta de "projetos.pastas"),
  // "{imagens}" (Imagens\WinHome), "{dataHora}" e "{arquivo}" (pede um arquivo do tipo "tipoArquivo").
  // "esperar": true roda escondido, espera o fim (até 2 min) e mostra a saída; se falhar, os passos seguintes são pulados.
  "acoesRapidas": [
    {
      "nome": "Dia de trabalho", "icone": "💼",
      "descricao": "Abre de uma vez os programas do trabalho: VS Code, IntelliJ, Teams, Outlook e Edge.",
      "passos": [
        { "nome": "VS Code", "editor": "vscode" },
        { "nome": "IntelliJ IDEA", "editor": "intellij" },
        { "nome": "Teams", "app": "MSTeams_8wekyb3d8bbwe!MSTeams" },
        { "nome": "Outlook", "app": "Microsoft.OutlookForWindows_8wekyb3d8bbwe!Microsoft.OutlookforWindows" },
        { "nome": "Edge", "app": "MSEdge" }
      ]
    },
    {
      "nome": "Abrir projetos", "icone": "📁",
      "descricao": "Abre a pasta de projetos (botão Pastas… do painel Projetos) no Explorador e no Terminal.",
      "passos": [
        { "nome": "Pasta no Explorador", "caminho": "explorer.exe", "args": "\"{pastaProjetos}\"" },
        { "nome": "Pasta no Terminal", "caminho": "wt.exe", "args": "-d \"{pastaProjetos}\"" }
      ]
    },
    {
      "nome": "Conectar TV", "icone": "📺",
      "descricao": "Liga a depuração sem fio com a TV. Depois disso, a TV aparece no Android Studio (Run/Debug sem cabo) e aceita os comandos do adb. Não muda nada na TV.",
      "passos": [
        { "nome": "Conectar à TV", "caminho": "adb", "args": "connect 192.168.15.11:5555", "esperar": true }
      ]
    },
    {
      "nome": "Espelhar TV", "icone": "🪞",
      "descricao": "Mostra a tela da TV numa janela do PC e deixa controlar com mouse e teclado (scrcpy): clique = toque/OK, botão direito = voltar, Ctrl+H = Home. Fechar a janela encerra o espelhamento.",
      "passos": [
        { "nome": "Conectar à TV", "caminho": "adb", "args": "connect 192.168.15.11:5555", "esperar": true },
        { "nome": "Espelhar com o scrcpy", "caminho": "scrcpy", "args": "-s 192.168.15.11:5555 --window-title \"TV\"" }
      ]
    },
    {
      "nome": "Print da TV", "icone": "📸",
      "descricao": "Tira um print do que está na tela da TV, salva em Imagens\\WinHome e abre a imagem.",
      "passos": [
        { "nome": "Conectar à TV", "caminho": "adb", "args": "connect 192.168.15.11:5555", "esperar": true },
        { "nome": "Capturar a tela na TV", "caminho": "adb", "args": "-s 192.168.15.11:5555 shell screencap -p /sdcard/winhome-print.png", "esperar": true },
        { "nome": "Copiar o print para o PC", "caminho": "adb", "args": "-s 192.168.15.11:5555 pull /sdcard/winhome-print.png \"{imagens}\\tv-{dataHora}.png\"", "esperar": true },
        { "nome": "Abrir o print", "caminho": "{imagens}\\tv-{dataHora}.png" }
      ]
    },
    {
      "nome": "Logs da TV", "icone": "📜",
      "descricao": "Abre um Terminal com o log da TV ao vivo (adb logcat), para acompanhar erros do launcher. Ctrl+C ou fechar a aba encerra.",
      "passos": [
        { "nome": "Conectar à TV", "caminho": "adb", "args": "connect 192.168.15.11:5555", "esperar": true },
        { "nome": "Log ao vivo no Terminal", "caminho": "wt.exe", "args": "--title \"Logs da TV\" adb -s 192.168.15.11:5555 logcat -v color" }
      ]
    },
    {
      "nome": "Instalar APK na TV", "icone": "📦", "tipoArquivo": ".apk",
      "descricao": "Escolha um arquivo .apk e ele é instalado na TV (atualiza se o app já existir, mantendo os dados).",
      "passos": [
        { "nome": "Conectar à TV", "caminho": "adb", "args": "connect 192.168.15.11:5555", "esperar": true },
        { "nome": "Instalar o APK", "caminho": "adb", "args": "-s 192.168.15.11:5555 install -r \"{arquivo}\"", "esperar": true }
      ]
    },
    {
      "nome": "Desconectar TV", "icone": "🔌",
      "descricao": "Encerra a depuração sem fio com a TV (o Android Studio deixa de vê-la).",
      "passos": [
        { "nome": "Desconectar a TV", "caminho": "adb", "args": "disconnect 192.168.15.11:5555", "esperar": true }
      ]
    }
  ],

  // Painel "videos": arquivos e links pelo VLC instalado, dentro do painel; links do YouTube pelo player do YouTube.
  // Volume e recentes ficam em %APPDATA%\WinHome\videos.json (fora desta config).
  // Painel "dispositivos": testa a porta de cada aparelho (só abre e fecha a conexão, sem comandos) a cada
  // "intervalo" segundos; clicar no aparelho mostra as ações do adb para ele (sempre com confirmação).
  "dispositivos": {
    "intervalo": 60,
    "lista": [
      { "nome": "TV",  "icone": "📺", "endereco": "192.168.15.11", "porta": 5555 },
      { "nome": "Box", "icone": "📡", "endereco": "192.168.15.13", "porta": 5555 }
    ]
  },

  "videos": {
    "repetir": false,              // recomeça o vídeo ao terminar (VLC)
    "pausarAoEsconder": true,      // pausa ao esconder ou minimizar a Home
    "pastaVlc": ""                 // vazio = C:\Program Files\VideoLAN\VLC
  },

  // Painéis em ordem de exibição. "visivel" liga/desliga o painel.
  // Ids especiais: "boasVindas" (saudação, hora, clima, cotações), "mensagem" (mensagem do dia),
  // "curiosidade" (curiosidades do dia), "projetos" (projetos recentes), "tarefas", "acoes" (ações rápidas) e "videos";
  // os demais ids são grupos de apps definidos em "grupos".
  "paineis": [
    { "id": "boasVindas", "visivel": true, "largura": 6 },
    { "id": "trabalho",   "visivel": true, "largura": 4, "titulo": "Trabalho" },
    { "id": "pessoal",    "visivel": true, "largura": 2, "titulo": "Pessoal" },
    { "id": "mensagem",   "visivel": true, "largura": 3, "titulo": "Mensagem do dia" },
    { "id": "curiosidade", "visivel": true, "largura": 3, "titulo": "Curiosidades do dia" }
  ],

  // Cada app usa "app" (AppID do menu Iniciar; veja com Get-StartApps no PowerShell)
  // ou "caminho" (arquivo .exe, pasta ou documento). Opcionais: "args", "pasta", "icone" (imagem).
  "grupos": {
    "trabalho": [
      { "nome": "Android Studio", "app": "{6D809377-6AF0-444B-8957-A3773F02200E}\\Android\\Android Studio\\bin\\studio64.exe" },
      { "nome": "VS Code",        "app": "Microsoft.VisualStudioCode" },
      { "nome": "Terminal",       "app": "Microsoft.WindowsTerminal_8wekyb3d8bbwe!App" },
      { "nome": "Claude",         "app": "Claude_pzs8sxrjxfjjc!Claude" },
      { "nome": "Chrome",         "app": "Chrome" },
      { "nome": "Edge",           "app": "MSEdge" },
      { "nome": "Outlook",        "app": "Microsoft.OutlookForWindows_8wekyb3d8bbwe!Microsoft.OutlookforWindows" },
      { "nome": "Teams",          "app": "MSTeams_8wekyb3d8bbwe!MSTeams" },
      { "nome": "Docker",         "app": "Docker.DockerForWindows.Settings" },
      { "nome": "DBeaver",        "caminho": "%LOCALAPPDATA%\\DBeaver\\dbeaver.exe" }
    ],
    "pessoal": [
      { "nome": "WhatsApp", "app": "5319275A.WhatsAppDesktop_cv1g1gvanyjgm!App" },
      { "nome": "Discord",  "app": "com.squirrel.Discord.Discord" }
    ]
  }
}
