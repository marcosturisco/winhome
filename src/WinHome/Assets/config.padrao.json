// Configuração do WinHome. Salve o arquivo e a Home atualiza sozinha.
// Comentários com // são permitidos. Opções ausentes usam o valor padrão.
// Salvar pela tela de Configurações regrava o arquivo sem comentários (anterior em config.json.bak).
// Todas as opções: docs/configuracao.md
{
  // Nome usado na saudação ("Bom dia, Marcos").
  "nome": "Marcos",

  // "maximizada" = ocupa a tela mas mantém a barra de tarefas; "telaCheia" = cobre tudo.
  "janela": "maximizada",

  // Tecla para mostrar/esconder a Home. Ex.: "Ctrl+Alt+Space", "Ctrl+Shift+H", "Alt+F1".
  "atalho": "Ctrl+Alt+Space",

  // true = abre a Home ao fazer login (cria o valor WinHome em HKCU\...\Run; false remove).
  "iniciarComWindows": false,

  // Esconde a Home depois de abrir um app.
  "esconderAoAbrirApp": true,

  // Caixa de busca no topo; digitar em qualquer lugar da Home também busca.
  "mostrarBusca": true,

  // Ícone na bandeja do sistema (clique mostra a Home; botão direito: Configurações, Sair).
  "iconeNaBandeja": true,

  "tema": {
    "modo": "escuro",              // "escuro", "claro" ou "sistema"
    "corDestaque": "#4F8CFF",      // títulos e relógio; "#RRGGBB" ou "#AARRGGBB"
    "fundo": "mica",               // "mica", "micaAlt", "acrilico", "cor" ou "imagem"
    "corFundo": "#101418",         // usada quando fundo = "cor"
    "imagemFundo": "",             // caminho da imagem quando fundo = "imagem"
    "fonte": "Segoe UI Variable",
    "cantos": 12,                  // arredondamento dos painéis
    "tamanhoIcone": 48,
    "opacidadePaineis": 0.6,       // 0 = transparente, 1 = sólido
    "espacamento": 16,             // distância entre painéis
    "colunas": 6                   // colunas da grade; cada painel ocupa "largura" colunas
  },

  // Painel do topo (id "boasVindas").
  "boasVindas": {
    "mostrarSaudacao": true,
    "mostrarData": true,
    "mostrarSegundos": false,
    // Clima (Open-Meteo). Adicione cidades pela busca em Configurações → Boas-vindas.
    "clima": {
      "visivel": true,
      "unidade": "C",
      "cidades": [
        { "nome": "São Paulo", "regiao": "São Paulo", "pais": "Brasil", "latitude": -23.5475, "longitude": -46.63611, "fuso": "America/Sao_Paulo" },
        { "nome": "Orlando", "regiao": "Flórida", "pais": "EUA", "latitude": 28.53834, "longitude": -81.37924, "fuso": "America/New_York" }
      ]
    },
    // Cotações em reais (AwesomeAPI): USD, EUR, GBP, JPY, CAD, AUD, CHF, CNY, ARS, BTC, ETH.
    "cotacoes": {
      "visivel": true,
      "moedas": [ "USD", "EUR" ]
    }
  },

  // Painel "mensagem": frase do dia. "fonte": "ambas", "embutidas" (do WinHome) ou "minhas".
  "mensagens": {
    "fonte": "ambas",
    "minhas": [
      // { "texto": "Minha frase", "autor": "Eu" }
    ]
  },

  // Painel "curiosidade": fatos da data de hoje com foto (Wikipédia "Neste dia").
  "curiosidades": {
    "incluirNascimentos": false,
    "incluirMortes": false
  },

  // Painel "projetos": recentes das IDEs + subpastas com git das "pastas".
  // Ligue em Configurações → Projetos (ou adicione { "id": "projetos" } em "paineis").
  "projetos": {
    "usarIntellij": true,
    "usarAndroidStudio": true,
    "usarVsCode": true,
    "pastas": [ "D:\\Documents\\dev" ],
    "maximo": 8,
    "editorPadrao": "origem",      // "origem" (IDE onde foi aberto), "vscode", "intellij" ou "androidStudio"
    "fixados": [],                 // caminhos que ficam sempre no topo
    "ocultos": [],                 // caminhos que não aparecem
    // Caminhos dos executáveis; vazio = detectar sozinho.
    "editores": { "vsCode": "", "intellij": "", "androidStudio": "" }
  },

  // Painéis em ordem de exibição. "visivel" liga/desliga o painel.
  // Ids especiais: "boasVindas" (saudação, hora, clima, cotações), "mensagem" (mensagem do dia),
  // "curiosidade" (curiosidades do dia) e "projetos" (projetos recentes);
  // os demais ids são grupos de apps definidos em "grupos".
  "paineis": [
    { "id": "boasVindas", "visivel": true, "largura": 6 },
    { "id": "trabalho",   "visivel": true, "largura": 4, "titulo": "Trabalho" },
    { "id": "pessoal",    "visivel": true, "largura": 2, "titulo": "Pessoal" },
    { "id": "mensagem",   "visivel": true, "largura": 3, "titulo": "Mensagem do dia" },
    { "id": "curiosidade", "visivel": true, "largura": 3, "titulo": "Curiosidades do dia" }
  ],

  // Cada app usa "app" (AppID do menu Iniciar; veja com Get-StartApps no PowerShell)
  // ou "caminho" (arquivo .exe, pasta ou documento). Opcionais: "args", "pasta", "icone" (imagem).
  "grupos": {
    "trabalho": [
      { "nome": "Android Studio", "app": "{6D809377-6AF0-444B-8957-A3773F02200E}\\Android\\Android Studio\\bin\\studio64.exe" },
      { "nome": "VS Code",        "app": "Microsoft.VisualStudioCode" },
      { "nome": "Terminal",       "app": "Microsoft.WindowsTerminal_8wekyb3d8bbwe!App" },
      { "nome": "Claude",         "app": "Claude_pzs8sxrjxfjjc!Claude" },
      { "nome": "Chrome",         "app": "Chrome" },
      { "nome": "Edge",           "app": "MSEdge" },
      { "nome": "Outlook",        "app": "Microsoft.OutlookForWindows_8wekyb3d8bbwe!Microsoft.OutlookforWindows" },
      { "nome": "Teams",          "app": "MSTeams_8wekyb3d8bbwe!MSTeams" },
      { "nome": "Docker",         "app": "Docker.DockerForWindows.Settings" },
      { "nome": "DBeaver",        "caminho": "%LOCALAPPDATA%\\DBeaver\\dbeaver.exe" }
    ],
    "pessoal": [
      { "nome": "WhatsApp", "app": "5319275A.WhatsAppDesktop_cv1g1gvanyjgm!App" },
      { "nome": "Discord",  "app": "com.squirrel.Discord.Discord" }
    ]
  }
}
