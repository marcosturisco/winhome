<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>WinHome</RootNamespace>
    <AssemblyName>WinHome</AssemblyName>
    <Version>1.0.9</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Main próprio em Program.cs (instância única antes de subir a interface) -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ical.Net" Version="5.2.3" />
    <PackageReference Include="LibVLCSharp.WinUI" Version="3.10.2" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\config.padrao.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\mensagens.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\web\youtube.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Publicação sem MSIX: o "dotnet publish" não leva os recursos da interface (WinHome.pri, *.xbf) e o app
       fecha ao abrir (0xC000027B no Microsoft.UI.Xaml.dll). Copia da pasta de build para a de publicação. -->
  <Target Name="CopiarRecursosDaInterface" AfterTargets="Publish">
    <ItemGroup>
      <RecursosDaInterface Include="$(OutDir)$(TargetName).pri;$(OutDir)**\*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(RecursosDaInterface)" DestinationFiles="@(RecursosDaInterface->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
